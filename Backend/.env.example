# ============================================
# Backend (Render / local) — copy to .env or .env.local
# ============================================

NODE_ENV=development
PORT=5000
HOST=localhost

# MongoDB (Atlas recommended for production)
MONGODB_URI=mongodb://localhost:27017/alumni_mentorship

# Auth
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_EXPIRE=7d

# CORS — your Vercel frontend URL(s), comma-separated for multiple
FRONTEND_URL=http://localhost:3000
CLIENT_ORIGIN=http://localhost:3000

# Optional alias
# CLIENT_URL=https://your-app.vercel.app

# Gemini (mentor ranking on Find Mentors)
# GEMINI_API_KEY=your-gemini-api-key-here
# GEMINI_MODEL=gemini-2.0-flash

# Optional: Cloudinary for fast avatar URLs (free tier at cloudinary.com)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=alumni-avatars
