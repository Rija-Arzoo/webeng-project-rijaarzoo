{
  "name": "alumni-mentorship-network",
  "description": "Monorepo: Frontend (Vercel) + Backend (Render)",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "install:all": "npm install --prefix Backend && npm install --prefix Frontend",
    "dev:backend": "npm run dev --prefix Backend",
    "dev:frontend": "npm run dev --prefix Frontend",
    "build:frontend": "npm run build --prefix Frontend",
    "start:backend": "npm start --prefix Backend",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "npm test --prefix Backend",
    "test:frontend": "npm run test:unit --prefix Frontend",
    "test:e2e": "npm run test:e2e --prefix Frontend",
    "test:e2e:smoke": "npm run test:e2e:smoke --prefix Frontend",
    "test:e2e:ui": "npm run test:e2e:ui --prefix Frontend"
  }
}
