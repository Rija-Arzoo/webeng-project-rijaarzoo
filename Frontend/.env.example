# ============================================
# Frontend (Vercel / local) — copy to .env.local
# Vite exposes only variables prefixed with VITE_
# ============================================

# Local backend
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000

# Production — separate Vercel backend project (REST only, no WebSockets)
# VITE_API_URL=https://your-backend.vercel.app/api
# VITE_ENABLE_SOCKET=false

# Local dev with `npm run dev` in Backend (Socket.io)
# VITE_SOCKET_URL=http://localhost:5000
# VITE_ENABLE_SOCKET=true

# Optional: client-side Gemini insights on Dashboard
# VITE_GEMINI_API_KEY=your-gemini-api-key-here
