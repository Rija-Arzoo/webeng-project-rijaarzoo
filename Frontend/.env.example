# ============================================
# Frontend — copy to .env.local for local dev
# ============================================

# Local (Vite proxies /api → http://localhost:5000)
VITE_API_URL=/api
VITE_SOCKET_URL=http://localhost:5000
VITE_ENABLE_SOCKET=true

# Production (set in Vercel Frontend project → Environment Variables)
# VITE_API_URL=https://YOUR-BACKEND.vercel.app/api
# VITE_ENABLE_SOCKET=false

# Optional client-side Gemini
# VITE_GEMINI_API_KEY=
